# ─── Backend API base URL (the /api prefix is part of the value) ───
VITE_API_URL=http://localhost:5050/api

# ─── Product analytics (optional). Leave blank to disable entirely. ───
# When set, PostHog is loaded from its CDN — no npm dependency is required.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
