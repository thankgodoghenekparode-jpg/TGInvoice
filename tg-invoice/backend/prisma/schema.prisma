// TG Invoice — Prisma schema
// Multi-tenant SaaS: shared database, logical tenant isolation via tenantId.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// Platform-level state for a business or an account. A SUSPENDED tenant is
// unreachable by every one of its members; a SUSPENDED user cannot sign in.
enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  CHEQUE
  ONLINE
  OTHER
  /// A settlement that reduces an invoice balance without cash changing hands
  /// (a credit note applied against the invoice). Never user-selectable.
  CREDIT_NOTE
}

enum DocumentKind {
  CUSTOMER
  QUOTATION
  INVOICE
  RECEIPT
  CREDIT_NOTE
  REFUND
}

// ─────────────────────────────────────────────
// Identity & Tenancy
// ─────────────────────────────────────────────

model User {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  email           String        @unique
  passwordHash    String
  avatar          String?
  emailVerified   Boolean       @default(false)
  isPlatformAdmin Boolean       @default(false) // platform operator — granted ONLY by db:superadmin or another platform admin
  status          AccountStatus @default(ACTIVE) // SUSPENDED blocks sign-in and every authenticated request
  suspendedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberships              Membership[]
  refreshTokens            RefreshToken[]
  passwordResets           PasswordResetToken[]
  emailVerifs              EmailVerificationToken[]
  invitations              Invitation[]             @relation("InvitedBy")
  createdQuotations        Quotation[]              @relation("QuotationCreator")
  createdInvoices          Invoice[]                @relation("InvoiceCreator")
  createdPayments          Payment[]                @relation("PaymentCreator")
  createdReceipts          Receipt[]                @relation("ReceiptCreator")
  auditLogs                AuditLog[]
  notifications            Notification[]
  createdRecurringInvoices RecurringInvoice[]       @relation("RecurringInvoiceCreator")
  uploadedAttachments      Attachment[]             @relation("AttachmentUploader")
  createdCreditNotes       CreditNote[]             @relation("CreditNoteCreator")
  createdRefunds           Refund[]                 @relation("RefundCreator")

  @@index([email])
}

model Tenant {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  slug             String        @unique
  logo             String?
  status           AccountStatus @default(ACTIVE) // SUSPENDED = platform-suspended: no member can reach it
  accessExpiresAt  DateTime? // optional tenant-level access expiry
  suspendedAt      DateTime? // when auto-suspended (e.g. due to expiry)
  suspensionReason String? // reason for suspension (auto or manual)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  memberships     Membership[]
  invitations     Invitation[]
  customers       Customer[]
  products        Product[]
  quotations      Quotation[]
  invoices        Invoice[]
  payments        Payment[]
  receipts        Receipt[]
  companySettings CompanySettings?
  auditLogs       AuditLog[]
  sequences       DocumentSequence[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordResetToken[]
  emailVerifs     EmailVerificationToken[]
  notifications   Notification[]

  recurringInvoices RecurringInvoice[]
  reminderRules     ReminderRule[]
  reminderSents     ReminderSent[]
  messageLogs       MessageLog[]
  attachments       Attachment[]
  customFields      CustomField[]
  customFieldValues CustomFieldValue[]
  documentTemplates DocumentTemplate[]
  creditNotes       CreditNote[]
  refunds           Refund[]
  referralsReceived Referral[]
  paymentIntents    PaymentIntent[]
}

model Membership {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  tenantId         String           @db.Uuid
  role             Role             @default(STAFF)
  status           MembershipStatus @default(ACTIVE)
  accessExpiresAt  DateTime? // optional per-member access expiry (UTC)
  suspendedAt      DateTime? // timestamp when auto-suspended due to expiry
  suspensionReason String? // reason for suspension (auto or manual)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([accessExpiresAt])
  @@index([suspendedAt])
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  email       String
  role        Role             @default(STAFF)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String           @db.Uuid
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tenantId  String?   @db.Uuid // last active tenant for this session
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tenantId  String?   @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tenantId  String?   @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ─────────────────────────────────────────────
// Business data (tenant-owned)
// ─────────────────────────────────────────────

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  customerCode String
  name         String
  companyName  String?
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  country      String?
  taxId        String?
  notes        String?
  isDemo       Boolean  @default(false) // true = generated by the demo seeder; removable via `npm run db:clear-demo`
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotations        Quotation[]
  invoices          Invoice[]
  payments          Payment[]
  receipts          Receipt[]
  recurringInvoices RecurringInvoice[]
  creditNotes       CreditNote[]
  refunds           Refund[]

  @@unique([tenantId, customerCode])
  @@index([tenantId])
  @@index([tenantId, name])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  category    String   @default("Other")
  unit        String   @default("unit")
  unitPrice   Decimal  @default(0) @db.Decimal(14, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  active      Boolean  @default(true)
  isDemo      Boolean  @default(false) // generated by the demo seeder
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotationItems QuotationItem[]
  invoiceItems   InvoiceItem[]

  @@index([tenantId])
  @@index([tenantId, name])
}

model DocumentSequence {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @db.Uuid
  kind     DocumentKind
  prefix   String
  next     Int          @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind])
}

model CompanySettings {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @db.Uuid

  businessName String?
  logo         String?
  address      String?
  phone        String?
  email        String?
  website      String?
  taxId        String?
  country      String? @default("Nigeria")

  currency         String @default("NGN")
  currencySymbol   String @default("₦")
  currencyPosition String @default("prefix") // prefix | suffix
  currencyDecimals Int    @default(2)

  bankName            String?
  accountName         String?
  accountNumber       String?
  paymentInstructions String?

  invoicePrefix   String @default("INV")
  quotationPrefix String @default("QT")
  receiptPrefix   String @default("REC")
  creditNotePrefix String @default("CN")
  refundPrefix     String @default("REF")

  defaultTaxRate  Decimal @default(0) @db.Decimal(5, 2)
  defaultCurrency String  @default("NGN")

  defaultInvoiceNotes   String?
  defaultQuotationTerms String?
  defaultReceiptNotes   String?

  onboardingComplete Boolean @default(false)

  /// Channels a document is pushed through automatically when marked "sent".
  /// Empty (default) = manual delivery only.
  autoSendChannels MessageChannel[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  customerId      String          @db.Uuid
  quotationNumber String
  quotationDate   DateTime        @default(now())
  validUntil      DateTime?
  reference       String?
  status          QuotationStatus @default(DRAFT)
  subtotal        Decimal         @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(14, 2)
  total           Decimal         @default(0) @db.Decimal(14, 2)
  notes           String?
  terms           String?
  createdById     String?         @db.Uuid
  isDemo          Boolean         @default(false) // generated by the demo seeder
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User?           @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     QuotationItem[]
  invoices  Invoice[]

  @@unique([tenantId, quotationNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
}

model QuotationItem {
  id             String        @id @default(uuid()) @db.Uuid
  quotationId    String        @db.Uuid
  productId      String?       @db.Uuid
  description    String
  quantity       Decimal       @db.Decimal(12, 2)
  unitPrice      Decimal       @db.Decimal(14, 2)
  discountType   DiscountType?
  discountValue  Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount Decimal       @default(0) @db.Decimal(14, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(14, 2)
  amount         Decimal       @default(0) @db.Decimal(14, 2)
  position       Int           @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @db.Uuid
  customerId         String        @db.Uuid
  quotationId        String?       @db.Uuid
  recurringInvoiceId String?       @db.Uuid
  invoiceNumber      String
  invoiceDate        DateTime      @default(now())
  dueDate            DateTime?
  reference          String?
  status             InvoiceStatus @default(DRAFT)
  subtotal           Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(14, 2)
  total              Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid         Decimal       @default(0) @db.Decimal(14, 2)
  balanceDue         Decimal       @default(0) @db.Decimal(14, 2)
  notes              String?
  terms              String?
  voidReason         String?
  createdById        String?       @db.Uuid
  isDemo             Boolean       @default(false) // generated by the demo seeder
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation        Quotation?        @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  createdBy        User?             @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recurringInvoice RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  items            InvoiceItem[]
  payments         Payment[]
  receipts         Receipt[]
  paymentIntents   PaymentIntent[]
  reminders        ReminderSent[]
  refunds          Refund[]
  creditNotes      CreditNote[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([recurringInvoiceId])
}

model InvoiceItem {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceId      String        @db.Uuid
  productId      String?       @db.Uuid
  description    String
  quantity       Decimal       @db.Decimal(12, 2)
  unitPrice      Decimal       @db.Decimal(14, 2)
  discountType   DiscountType?
  discountValue  Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount Decimal       @default(0) @db.Decimal(14, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(14, 2)
  amount         Decimal       @default(0) @db.Decimal(14, 2)
  position       Int           @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  invoiceId     String        @db.Uuid
  customerId    String        @db.Uuid
  amount        Decimal       @db.Decimal(14, 2)
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  reference     String?
  notes         String?
  createdById   String?       @db.Uuid
  isDemo        Boolean       @default(false) // generated by the demo seeder
  createdAt     DateTime      @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  receipt   Receipt?
  refunds   Refund[]

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
}

model Receipt {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  paymentId     String        @unique @db.Uuid
  invoiceId     String        @db.Uuid
  customerId    String        @db.Uuid
  receiptNumber String
  receiptDate   DateTime      @default(now())
  amount        Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  reference     String?
  description   String?
  notes         String?
  voidReason    String?
  status        String        @default("ISSUED") // ISSUED | VOID
  createdById   String?       @db.Uuid
  isDemo        Boolean       @default(false) // generated by the demo seeder
  createdAt     DateTime      @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("ReceiptCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String?  @db.Uuid
  action      String
  entity      String
  entityId    String?
  entityLabel String?
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity])
  @@index([tenantId, userId])
}

/// Per-user, server-persisted notifications (in-app bell + unread badge).
/// tenantId is the related business when the notice is about one; null for
/// platform-level notices. Optional fields keep arbitrary event payloads
/// out of the schema — `link` is an in-app route, never user input.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tenantId  String?   @db.Uuid
  type      String // TENANT_SUSPENDED | ACCESS_GRANTED | PAYMENT_RECEIVED | …
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────
// Infrastructure: background jobs & feature flags
// ─────────────────────────────────────────────

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Durable work queue. The API enqueues; `npm run worker` drains it. Claims use
/// `FOR UPDATE SKIP LOCKED`, so any number of workers can run safely.
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  priority    Int       @default(0)
  dedupeKey   String?   @unique // idempotency: at most one live job per key
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([type, status])
  @@index([status, lockedAt])
}

/// Simple feature flags + percentage/allowlist rollout, read by `/api/flags`.
model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  rollout     Int      @default(100) // 0–100, deterministic by tenant id
  tenantIds   Json? // explicit allowlist (array of tenant ids), if set
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Recurring invoices & dunning
// ─────────────────────────────────────────────

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model RecurringInvoice {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  customerId     String              @db.Uuid
  name           String
  frequency      RecurrenceFrequency @default(MONTHLY)
  interval       Int                 @default(1) // every N frequency units
  nextRunAt      DateTime
  lastRunAt      DateTime?
  endDate        DateTime?
  dueInDays      Int                 @default(14)
  autoSend       Boolean             @default(true) // email/WhatsApp each generated invoice
  autoCharge     Boolean             @default(false) // charge a saved gateway reference
  status         RecurringStatus     @default(ACTIVE)
  reference      String?
  notes          String?
  terms          String?
  generatedCount Int                 @default(0)
  createdById    String?             @db.Uuid
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User?                  @relation("RecurringInvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     RecurringInvoiceItem[]
  invoices  Invoice[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status, nextRunAt])
}

model RecurringInvoiceItem {
  id                 String        @id @default(uuid()) @db.Uuid
  recurringInvoiceId String        @db.Uuid
  productId          String?       @db.Uuid
  description        String
  quantity           Decimal       @db.Decimal(12, 2)
  unitPrice          Decimal       @db.Decimal(14, 2)
  discountType       DiscountType?
  discountValue      Decimal       @default(0) @db.Decimal(14, 2)
  taxRate            Decimal       @default(0) @db.Decimal(5, 2)
  position           Int           @default(0)

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)

  @@index([recurringInvoiceId])
}

enum ReminderStage {
  BEFORE_DUE
  ON_DUE
  AFTER_DUE
}

enum MessageChannel {
  EMAIL
  WHATSAPP
  SMS
}

/// A dunning rule: when + how to chase an unpaid invoice.
/// `offsetDays` is signed relative to the due date (−3 = three days before due).
model ReminderRule {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  name         String
  enabled      Boolean          @default(true)
  stage        ReminderStage    @default(AFTER_DUE)
  offsetDays   Int              @default(0)
  channels     MessageChannel[] @default([EMAIL])
  subject      String?
  bodyTemplate String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sent   ReminderSent[]

  @@index([tenantId])
  @@index([tenantId, enabled])
}

/// Record of a dunning reminder already sent, so each rule chases an invoice
/// exactly once (re-running the scanner is therefore safe).
model ReminderSent {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  ruleId    String           @db.Uuid
  invoiceId String           @db.Uuid
  stage     ReminderStage
  channels  MessageChannel[] @default([])
  sentAt    DateTime         @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule    ReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([ruleId, invoiceId])
  @@index([tenantId, sentAt])
  @@index([invoiceId])
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/// Delivery log for WhatsApp / SMS / email sends (audit + debugging + resend).
model MessageLog {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @db.Uuid
  channel           MessageChannel
  to                String
  subject           String?
  body              String?
  status            MessageStatus  @default(QUEUED)
  provider          String?
  providerMessageId String?
  error             String?
  documentKind      DocumentKind?
  documentId        String?        @db.Uuid
  customerId        String?        @db.Uuid
  createdAt         DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, channel])
  @@index([documentKind, documentId])
}

// ─────────────────────────────────────────────
// Attachments, custom fields & document templates
// ─────────────────────────────────────────────

/// A file attached to any document (contract on a quotation, PO scan, etc.).
/// documentId is polymorphic (CUSTOMER/QUOTATION/INVOICE/RECEIPT/CREDIT_NOTE),
/// so it is a plain indexed column — integrity is enforced in the controller.
model Attachment {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  documentKind DocumentKind
  documentId   String       @db.Uuid
  fileName     String
  mimeType     String
  size         Int
  key          String // storage key (never a filesystem path)
  uploadedById String?      @db.Uuid
  createdAt    DateTime     @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId, documentKind, documentId])
  @@index([tenantId, createdAt])
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

/// A tenant-defined extra field on customers/documents.
model CustomField {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  entity         DocumentKind
  key            String
  label          String
  type           CustomFieldType @default(TEXT)
  options        Json? // for SELECT
  required       Boolean         @default(false)
  showOnDocument Boolean         @default(false) // print on the PDF
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]

  @@unique([tenantId, entity, key])
  @@index([tenantId, entity])
}

model CustomFieldValue {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  fieldId   String       @db.Uuid
  entity    DocumentKind
  entityId  String       @db.Uuid
  value     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  field  CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityId])
  @@index([tenantId, entity, entityId])
}

/// A visual template for generated PDFs. One default per (tenant, kind).
model DocumentTemplate {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  name            String
  kind            DocumentKind
  isDefault       Boolean      @default(false)
  accentColor     String? // hex, e.g. #2563eb
  showLogo        Boolean      @default(true)
  showBankDetails Boolean      @default(true)
  headerNote      String?
  footerNote      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind])
}

// ─────────────────────────────────────────────
// Credit notes / refunds
// ─────────────────────────────────────────────

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  VOID
}

model CreditNote {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  customerId       String           @db.Uuid
  invoiceId        String?          @db.Uuid
  creditNoteNumber String
  creditNoteDate   DateTime         @default(now())
  status           CreditNoteStatus @default(DRAFT)
  subtotal         Decimal          @default(0) @db.Decimal(14, 2)
  discountAmount   Decimal          @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal          @default(0) @db.Decimal(14, 2)
  total            Decimal          @default(0) @db.Decimal(14, 2)
  amountApplied    Decimal          @default(0) @db.Decimal(14, 2)
  reason           String?
  notes            String?
  createdById      String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice   Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("CreditNoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     CreditNoteItem[]
  refunds   Refund[]

  @@unique([tenantId, creditNoteNumber])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
}

model CreditNoteItem {
  id            String        @id @default(uuid()) @db.Uuid
  creditNoteId  String        @db.Uuid
  productId     String?       @db.Uuid
  description   String
  quantity      Decimal       @db.Decimal(12, 2)
  unitPrice     Decimal       @db.Decimal(14, 2)
  discountType  DiscountType?
  discountValue Decimal       @default(0) @db.Decimal(14, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  amount        Decimal       @default(0) @db.Decimal(14, 2)
  position      Int           @default(0)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
}

enum RefundStatus {
  COMPLETED
  VOID
}

/// Money paid back to a customer. Kept as its own record (never a negative
/// Payment) so cash-out is auditable and dashboards stay honest. A refund may
/// stand alone, or be tied to an invoice, a credit note, or a specific payment.
model Refund {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  customerId   String        @db.Uuid
  invoiceId    String?       @db.Uuid
  creditNoteId String?       @db.Uuid
  paymentId    String?       @db.Uuid
  refundNumber String
  amount       Decimal       @db.Decimal(14, 2)
  refundDate   DateTime      @default(now())
  method       PaymentMethod @default(BANK_TRANSFER)
  reference    String?
  reason       String?
  notes        String?
  voidReason   String?
  status       RefundStatus  @default(COMPLETED)
  createdById  String?       @db.Uuid
  isDemo       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  creditNote CreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)
  payment    Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("RefundCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, refundNumber])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────
// Growth: referrals, partners, online payments
// ─────────────────────────────────────────────

enum ReferralStatus {
  PENDING
  ACTIVE
  REWARDED
  EXPIRED
}

/// A shareable code owned by the platform, a business or a user.
model ReferralCode {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  ownerType   String   @default("TENANT") // PLATFORM | TENANT | USER | PARTNER
  ownerId     String?  @db.Uuid
  rewardType  String   @default("PERCENT") // PERCENT | FIXED
  rewardValue Decimal  @default(0) @db.Decimal(10, 2)
  active      Boolean  @default(true)
  uses        Int      @default(0)
  maxUses     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  referrals Referral[]
}

model Referral {
  id               String         @id @default(uuid()) @db.Uuid
  codeId           String         @db.Uuid
  referrerTenantId String?        @db.Uuid
  referredTenantId String         @db.Uuid
  referredUserId   String?        @db.Uuid
  status           ReferralStatus @default(PENDING)
  rewardAmount     Decimal        @default(0) @db.Decimal(14, 2)
  rewardedAt       DateTime?
  createdAt        DateTime       @default(now())

  code           ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  referredTenant Tenant       @relation(fields: [referredTenantId], references: [id], onDelete: Cascade)

  @@index([codeId])
  @@index([referredTenantId])
  @@index([referrerTenantId])
}

/// Reseller / accountant / affiliate program member.
model Partner {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  type           String   @default("AFFILIATE") // RESELLER | ACCOUNTANT | AFFILIATE
  email          String?
  phone          String?
  companyName    String?
  commissionRate Decimal  @default(0) @db.Decimal(5, 2)
  status         String   @default("ACTIVE") // ACTIVE | SUSPENDED
  userId         String?  @db.Uuid
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type, status])
}

enum PaymentIntentStatus {
  PENDING
  SUCCEEDED
  FAILED
  ABANDONED
}

/// A hosted-checkout attempt against an invoice. The gateway webhook flips
/// this to SUCCEEDED and records the matching Payment + Receipt.
model PaymentIntent {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  invoiceId   String              @db.Uuid
  customerId  String              @db.Uuid
  provider    String              @default("PAYSTACK") // PAYSTACK | FLUTTERWAVE
  reference   String              @unique // our idempotency reference
  providerRef String?
  amount      Decimal             @db.Decimal(14, 2)
  currency    String              @default("NGN")
  status      PaymentIntentStatus @default(PENDING)
  checkoutUrl String?
  metadata    Json?
  paidAt      DateTime?
  createdById String?             @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([invoiceId])
  @@index([status])
}
