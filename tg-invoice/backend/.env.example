# ─── Database (Neon PostgreSQL in production) ───
DATABASE_URL="postgresql://user:password@host:5432/tg_invoice?sslmode=require"
# Local alternative: postgresql://postgres:postgres@localhost:5432/tg_invoice

# ─── Auth ───
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=7

# ─── Server ───
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Email (SMTP). If unset, email features disable gracefully. ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="TG Invoice"

# ─── Public sharing (WhatsApp / email "view online" links) ───
# Absolute base URL clients can reach your API at. Used inside share links.
PUBLIC_BASE_URL=http://localhost:5000
# Secret used to sign public share tokens (falls back to JWT_SECRET if unset).
SHARE_SECRET="change-me-to-a-long-random-string"
# How long a shared document link stays valid, in days.
SHARE_LINK_DAYS=30

# ─── File storage (local disk driver by default; cloud driver ready for production) ───
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="uploads"
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
