# ─── Database (Neon PostgreSQL in production) ───
DATABASE_URL="postgresql://user:password@host:5432/tg_invoice?sslmode=require"
# Local alternative: postgresql://postgres:postgres@localhost:5432/tg_invoice

# ─── Auth ───
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=7

# ─── Server ───
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Email (SMTP). If unset, email features disable gracefully. ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="TG Invoice"

# ─── Public sharing (WhatsApp / email "view online" links) ───
# Absolute base URL clients can reach your API at. Used inside share links.
PUBLIC_BASE_URL=http://localhost:5000
# Secret used to sign public share tokens (falls back to JWT_SECRET if unset).
SHARE_SECRET="change-me-to-a-long-random-string"
# How long a shared document link stays valid, in days.
SHARE_LINK_DAYS=30

# ─── File storage (local disk driver by default; cloud driver ready for production) ───
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="uploads"
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=

# ─── Background jobs (recurring invoices, dunning reminders, async sends) ───
# Production runs a dedicated worker:  npm run worker
# Set INLINE_WORKER=true to also drain jobs inside the API process (dev/single instance).
INLINE_WORKER=false
JOBS_POLL_MS=5000
JOBS_BATCH_SIZE=10
JOBS_MAX_ATTEMPTS=5

# ─── Cache & rate limiting ───
CACHE_DRIVER=memory          # memory | redis
CACHE_TTL_SECONDS=30
# REDIS_URL=redis://default:password@host:6379
RATE_LIMIT_PER_TENANT=600
RATE_LIMIT_TENANT_WINDOW_MS=60000

# ─── WhatsApp Cloud API (automatic document / reminder delivery). Unset = disabled. ───
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BUSINESS_NUMBER=

# ─── SMS (Termii / Africa's Talking / Twilio). Unset = disabled. ───
SMS_PROVIDER=                # termii | africas_talking | twilio
SMS_API_KEY=
SMS_SENDER_ID=
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ─── Online payments (Paystack / Flutterwave). Unset = payment links disabled. ───
PAYMENT_PROVIDER=            # paystack | flutterwave
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=

# ─── Product analytics (PostHog). Unset = disabled. ───
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
APP_URL=http://localhost:5173
